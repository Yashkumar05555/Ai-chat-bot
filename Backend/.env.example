GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Primary Gemini model. Must be a model id returned by ModelService.ListModels.
GEMINI_MODEL=gemini-flash-lite-latest
# Comma-separated fallback models tried in order on 429/503 quota/overload errors.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview,gemini-3.6-flash
DATABASE_URL=sqlite+aiosqlite:///./data/chats.db
WS_HOST=0.0.0.0
WS_PORT=8000
